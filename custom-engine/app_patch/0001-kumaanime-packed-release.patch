--- /dev/null
+++ b/tool/build_packed_release.sh
@@ -0,0 +1,82 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+APP_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
+SDK_ROOT="${FLUTTER_ROOT:-$(sed -n 's/^flutter.sdk=//p' "$APP_ROOT/android/local.properties")}"
+PACKER="$SDK_ROOT/custom-engine/scripts/build_packed_release.py"
+
+if [[ ! -f "$PACKER" ]]; then
+  echo "Custom engine packer missing: $PACKER" >&2
+  exit 2
+fi
+if [[ $# -gt 1 || ( $# -eq 1 && "$1" != "-v" && "$1" != "--verbose" ) ]]; then
+  echo "usage: tool/build_packed_release.sh [-v]" >&2
+  exit 2
+fi
+
+# Keep Gradle within a predictable memory budget on the macOS build host.
+export GRADLE_OPTS="${GRADLE_OPTS:-} -Dorg.gradle.workers.max=2 -Dorg.gradle.parallel=false -Dorg.gradle.daemon=false \"-Dorg.gradle.jvmargs=-Xmx3G -XX:MaxMetaspaceSize=1G -XX:ReservedCodeCacheSize=256m -XX:ActiveProcessorCount=2\""
+ARGS=()
+if [[ $# -eq 1 ]]; then ARGS+=(--verbose); fi
+# Keep a unique symbol archive outside the app checkout and APK for crash reports.
+SYMBOL_ROOT="${KUMA_SYMBOL_ROOT:-${XDG_STATE_HOME:-$HOME/.local/state}/kumaanime/release-symbols}"
+mkdir -p "$SYMBOL_ROOT"
+SYMBOL_DIR="$(mktemp -d "$SYMBOL_ROOT/packed-$(date -u +%Y%m%dT%H%M%SZ)-XXXXXXXX")"
+echo "Dart AOT symbols: $SYMBOL_DIR"
+WORK="$(mktemp -d)"
+FLUTTER_APK_DIR="$APP_ROOT/build/app/outputs/flutter-apk"
+GRADLE_APK_DIR="$APP_ROOT/build/app/outputs/apk/release"
+REPORT="$APP_ROOT/build/app/outputs/packed-release-report.json"
+PREVIOUS="$WORK/previous"
+HAVE_PREVIOUS=0
+BUILD_OK=0
+PAIR_VERIFIER="$SDK_ROOT/custom-engine/scripts/verify_packed_pair.py"
+if [[ -f "$FLUTTER_APK_DIR/app-arm64-v8a-release.apk" &&
+      -f "$FLUTTER_APK_DIR/app-armeabi-v7a-release.apk" ]] &&
+   python3 "$PAIR_VERIFIER" --app "$APP_ROOT" \
+     --engine-src "$SDK_ROOT/engine/src" >/dev/null 2>&1; then
+  mkdir -p "$PREVIOUS"
+  cp "$FLUTTER_APK_DIR/app-arm64-v8a-release.apk" "$PREVIOUS/"
+  cp "$FLUTTER_APK_DIR/app-armeabi-v7a-release.apk" "$PREVIOUS/"
+  if [[ -f "$REPORT" ]]; then cp "$REPORT" "$PREVIOUS/report.json"; fi
+  HAVE_PREVIOUS=1
+fi
+restore_on_exit() {
+  local rc=$?
+  set +e
+  if [[ "$BUILD_OK" -ne 1 ]]; then
+    for abi in arm64-v8a armeabi-v7a; do
+      local apk="app-${abi}-release.apk"
+      if [[ "$HAVE_PREVIOUS" -eq 1 ]]; then
+        mkdir -p "$FLUTTER_APK_DIR" "$GRADLE_APK_DIR"
+        cp "$PREVIOUS/$apk" "$FLUTTER_APK_DIR/$apk"
+        cp "$PREVIOUS/$apk" "$GRADLE_APK_DIR/$apk"
+        shasum -a 1 "$FLUTTER_APK_DIR/$apk" | cut -d' ' -f1 > "$FLUTTER_APK_DIR/$apk.sha1"
+      else
+        rm -f "$FLUTTER_APK_DIR/$apk" "$FLUTTER_APK_DIR/$apk.sha1" \
+          "$GRADLE_APK_DIR/$apk"
+      fi
+    done
+    if [[ -f "$PREVIOUS/report.json" ]]; then
+      cp "$PREVIOUS/report.json" "$REPORT"
+    else
+      rm -f "$REPORT"
+    fi
+    rm -f "$FLUTTER_APK_DIR/app-release.apk" \
+      "$FLUTTER_APK_DIR/app-release.apk.sha1" \
+      "$GRADLE_APK_DIR/app-release.apk"
+    echo "Packed release failed; previous verified APK pair restored or stock APKs removed." >&2
+  fi
+  rm -rf "$WORK"
+  exit "$rc"
+}
+trap restore_on_exit EXIT
+trap 'exit 130' INT
+trap 'exit 143' TERM
+KUMA_PACKED_STAGING=1 python3 "$PACKER" \
+  --app "$APP_ROOT" \
+  --flutter-root "$SDK_ROOT" \
+  --split-debug-info "$SYMBOL_DIR" \
+  --output-dir "$WORK" \
+  --replace-standard "${ARGS[@]}"
+BUILD_OK=1
